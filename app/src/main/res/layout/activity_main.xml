<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/dark_background"
    tools:context=".MainActivity"
    tools:ignore="all">

<LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="0dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:background="@color/dark_background"
        tools:ignore="VisualLintBounds">

    <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/title_input_data"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/text_high_contrast"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/tvPublicIp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/public_ip_loading"
            android:textColor="#FF8800"
            android:textSize="14sp"
            android:textStyle="bold"
            android:minHeight="48dp"
            android:gravity="start|center_vertical"
            android:layout_marginBottom="16dp"
            android:padding="0dp"
            android:background="?android:attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true" />

    <EditText
        android:id="@+id/etIpAddress"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="48dp"
        android:hint="@string/hint_ip_address"
        android:inputType="phone"
        android:digits="0123456789."
        android:maxLength="15"
        android:textColor="@color/text_high_contrast"
        android:textColorHint="@color/text_hint_color"
        android:importantForAutofill="no"
        android:layout_marginBottom="12dp"
        tools:ignore="SpeakableTextPresent" />

    <EditText
        android:id="@+id/etPrefix"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="48dp"
        android:hint="@string/hint_network_prefix"
        android:inputType="number"
        android:maxLength="2"
        android:importantForAutofill="no"
        android:layout_marginBottom="16dp"
        android:textColor="@color/text_high_contrast"
        android:textColorHint="@color/text_hint_color"
        tools:ignore="SpeakableTextPresent" />

    <!-- КНОПКА РАСЧЁТ -->
    <Button
        android:id="@+id/btnCalculate"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/btn_calculate"
        android:maxLines="1"
        android:backgroundTint="@color/orange_primary"
        android:textColor="@color/white"/>

    <!-- Analysis Results -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/title_analysis_results"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/text_high_contrast"
            android:layout_marginBottom="8dp" />

        <!-- Subnet Mask -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="6dp">
            <TextView
                android:id="@+id/tvNetmask"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/label_subnet_mask"
                android:textStyle="bold"
                android:textColor="@color/text_high_contrast"
                android:maxLines="1"
                android:autoSizeTextType="uniform"
                android:autoSizeMinTextSize="11sp"
                android:autoSizeMaxTextSize="14sp"
                android:autoSizeStepGranularity="1sp" />
        </LinearLayout>

        <!-- Network ID -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="6dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/label_network_id"
                android:textStyle="bold"
                android:textColor="@color/text_high_contrast"
                android:layout_marginEnd="8dp" />
            <TextView
                android:id="@+id/tvNetworkId"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/default_placeholder"
                android:textColor="@color/text_high_contrast" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="8dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/label_wildcard"
                android:textColor="@color/text_high_contrast"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvWildcard"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/default_placeholder"
                android:textColor="@color/text_high_contrast" />
        </LinearLayout>


        <!-- Broadcast Address -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="6dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/label_broadcast_address"
                android:textStyle="bold"
                android:textColor="@color/text_high_contrast"
                android:layout_marginEnd="8dp" />
            <TextView
                android:id="@+id/tvBroadcast"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/default_placeholder"
                android:textColor="@color/text_high_contrast" />
        </LinearLayout>

        <!-- First Usable Host -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="6dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/label_first_usable_host"
                android:textStyle="bold"
                android:textColor="@color/text_high_contrast"
                android:layout_marginEnd="8dp" />
            <TextView
                android:id="@+id/tvFirstHost"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/default_placeholder"
                android:textColor="@color/text_high_contrast" />
        </LinearLayout>

        <!-- Last Usable Host -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="6dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/label_last_usable_host"
                android:textStyle="bold"
                android:textColor="@color/text_high_contrast"
                android:layout_marginEnd="8dp" />
            <TextView
                android:id="@+id/tvLastHost"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/default_placeholder"
                android:textColor="@color/text_high_contrast" />
        </LinearLayout>

        <!-- Total Usable Hosts -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="24dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/label_total_usable_hosts"
                android:textStyle="bold"
                android:textColor="@color/text_high_contrast"
                android:layout_marginEnd="8dp" />
            <TextView
                android:id="@+id/tvUsableHosts"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/default_placeholder"
                android:textColor="@color/text_high_contrast" />
        </LinearLayout>

        <!-- Класс сети -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="6dp">
            <TextView
                android:id="@+id/tvNetworkClass"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/label_network_class"
                android:textStyle="bold"
                android:textColor="@color/text_high_contrast"
                android:maxLines="1"
                android:autoSizeTextType="uniform"
                android:autoSizeMinTextSize="11sp"
                android:autoSizeMaxTextSize="14sp"
                android:autoSizeStepGranularity="1sp" />
        </LinearLayout>

        <!-- Тип сети: Приватная / Публичная -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="8dp">
            <TextView
                android:id="@+id/tvNetworkType"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/label_network_type"
                android:textStyle="bold"
                android:textColor="@color/text_high_contrast"
                android:maxLines="1"
                android:autoSizeTextType="uniform"
                android:autoSizeMinTextSize="11sp"
                android:autoSizeMaxTextSize="14sp"
                android:autoSizeStepGranularity="1sp" />
        </LinearLayout>

        <!-- Ряд с кнопками Очистить и Копировать с авторазмером шрифта -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="8dp">

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnClear"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/btn_clear"
                android:maxLines="1"
                android:layout_marginEnd="8dp"
                android:backgroundTint="@color/text_hint_color"
                android:textColor="@color/white"
                android:autoSizeTextType="uniform"
                android:autoSizeMinTextSize="10sp"
                android:autoSizeMaxTextSize="14sp"
                android:autoSizeStepGranularity="1sp" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnCopy"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/btn_copy"
                android:maxLines="1"
                android:layout_marginStart="8dp"
                android:backgroundTint="@color/orange_primary"
                android:textColor="@color/white"
                android:autoSizeTextType="uniform"
                android:autoSizeMinTextSize="10sp"
                android:autoSizeMaxTextSize="14sp"
                android:autoSizeStepGranularity="1sp" />
        </LinearLayout>

        <!-- Calculation History -->
        <Button
            android:id="@+id/btnHistory"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/btn_history"
            android:maxLines="1"
            android:background="@drawable/orange_button_background"
            android:textColor="@color/white"
            android:textSize="14sp"
            android:layout_marginTop="8dp"
            android:autoSizeTextType="uniform"
            android:autoSizeMinTextSize="10sp"
            android:autoSizeMaxTextSize="14sp"
            android:autoSizeStepGranularity="1sp"
            android:contentDescription="@string/btn_history_description"/>

    </LinearLayout>
</ScrollView>

