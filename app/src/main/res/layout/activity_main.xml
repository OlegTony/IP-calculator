<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://android.com"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    tools:context=".MainActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="16dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:background="@color/white">


    <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/title_input_data"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/text_high_contrast"
            android:layout_marginBottom="8dp" />

        <EditText
            android:id="@+id/etIpAddress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:hint="@string/hint_ip_address"
            android:inputType="phone"
            android:digits="0123456789."
            android:maxLength="15"
            android:textColor="@color/text_high_contrast"
            android:textColorHint="#757575"
            android:importantForAutofill="no"
            android:layout_marginBottom="12dp"
            tools:ignore="SpeakableTextPresent" />

        <EditText
            android:id="@+id/etPrefix"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:hint="@string/hint_network_prefix"
            android:inputType="number"
            android:maxLength="2"
            android:importantForAutofill="no"
            android:layout_marginBottom="16dp"
            android:textColor="@color/text_high_contrast"
            android:textColorHint="#757575"
            tools:ignore="SpeakableTextPresent" />

        <Button
            android:id="@+id/btnCalculate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/btn_calculate"
            android:textSize="16sp"
            android:backgroundTint="@color/primary_dark_blue"
            android:layout_marginBottom="24dp" />

        <!-- Analysis Results -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/title_analysis_results"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/text_high_contrast"
            android:layout_marginBottom="8dp" />

        <!-- Subnet Mask -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="6dp">
            <TextView
                android:id="@+id/tvNetmask"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/label_subnet_mask"
                android:textStyle="bold"
                android:textColor="@color/text_high_contrast"
                android:maxLines="1"
                android:autoSizeTextType="uniform"
                android:autoSizeMinTextSize="11sp"
                android:autoSizeMaxTextSize="14sp"
                android:autoSizeStepGranularity="1sp" />
        </LinearLayout>

        <!-- Network ID -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="6dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/label_network_id"
                android:textStyle="bold"
                android:textColor="@color/text_high_contrast"
                android:layout_marginEnd="8dp" />
            <TextView
                android:id="@+id/tvNetworkId"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/default_placeholder"
                android:textColor="@color/text_high_contrast" />
        </LinearLayout>

        <!-- Broadcast Address -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="6dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/label_broadcast_address"
                android:textStyle="bold"
                android:textColor="@color/text_high_contrast"
                android:layout_marginEnd="8dp" />
            <TextView
                android:id="@+id/tvBroadcast"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/default_placeholder"
                android:textColor="@color/text_high_contrast" />
        </LinearLayout>

        <!-- First Usable Host -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="6dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/label_first_usable_host"
                android:textStyle="bold"
                android:textColor="@color/text_high_contrast"
                android:layout_marginEnd="8dp" />
            <TextView
                android:id="@+id/tvFirstHost"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/default_placeholder"
                android:textColor="@color/text_high_contrast" />
        </LinearLayout>

        <!-- Last Usable Host -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="6dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/label_last_usable_host"
                android:textStyle="bold"
                android:textColor="@color/text_high_contrast"
                android:layout_marginEnd="8dp" />
            <TextView
                android:id="@+id/tvLastHost"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/default_placeholder"
                android:textColor="@color/text_high_contrast" />
        </LinearLayout>

        <!-- Total Usable Hosts -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="24dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/label_total_usable_hosts"
                android:textStyle="bold"
                android:textColor="@color/text_high_contrast"
                android:layout_marginEnd="8dp" />
            <TextView
                android:id="@+id/tvUsableHosts"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/default_placeholder"
                android:textColor="@color/text_high_contrast" />
        </LinearLayout>

        <!-- Класс сети (Шаг 4) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="6dp">
            <TextView
                android:id="@+id/tvNetworkClass"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/label_network_class"
                android:textStyle="bold"
                android:textColor="@color/text_high_contrast"
                android:maxLines="1"
                android:autoSizeTextType="uniform"
                android:autoSizeMinTextSize="11sp"
                android:autoSizeMaxTextSize="14sp"
                android:autoSizeStepGranularity="1sp" />
        </LinearLayout>

        <!-- Тип сети: Приватная / Публичная (Шаг 4) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="24dp">
            <TextView
                android:id="@+id/tvNetworkType"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/label_network_type"
                android:textStyle="bold"
                android:textColor="@color/text_high_contrast"
                android:maxLines="1"
                android:autoSizeTextType="uniform"
                android:autoSizeMinTextSize="11sp"
                android:autoSizeMaxTextSize="14sp"
                android:autoSizeStepGranularity="1sp" />
        </LinearLayout>

        <!-- Ряд с кнопками Очистить и Копировать с авторазмером шрифта -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="16dp">

            <Button
                android:id="@+id/btnClear"
                style="?android:attr/buttonBarButtonStyle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/btn_clear"
                android:maxLines="1"
                android:layout_marginEnd="8dp"
                android:backgroundTint="#757575"
                android:textColor="@color/white"
                android:autoSizeTextType="uniform"
                android:autoSizeMinTextSize="10sp"
                android:autoSizeMaxTextSize="14sp"
                android:autoSizeStepGranularity="1sp" />

            <Button
                android:id="@+id/btnCopy"
                style="?android:attr/buttonBarButtonStyle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/btn_copy"
                android:maxLines="1"
                android:layout_marginStart="8dp"
                android:backgroundTint="@color/primary_dark_blue"
                android:textColor="@color/white"
                android:autoSizeTextType="uniform"
                android:autoSizeMinTextSize="10sp"
                android:autoSizeMaxTextSize="14sp"
                android:autoSizeStepGranularity="1sp" />
        </LinearLayout>


    </LinearLayout>
</ScrollView>
