<resources xmlns:tools="http://android.com">
    <!-- Базовая тема приложения -->
    <style name="Theme.IPCalculator" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Главные цвета бренда (наши оранжевые кнопки) -->
        <item name="colorPrimary">@color/orange_primary</item>
        <item name="colorPrimaryVariant">@color/orange_border</item>
        <item name="colorOnPrimary">@color/white</item>

        <!-- Цвета фона приложения -->
        <item name="android:windowBackground">@color/dark_background</item>
        <item name="colorSurface">@color/dark_surface</item>
        <item name="colorOnSurface">@color/text_primary</item>

        <item name="android:statusBarColor">@color/dark_background</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>
